{
  "manifest_version": 3,
  "name": "Tab Sleeper",
  "version": "1.0",
  "description": "Unloads tabs that have been inactive for 5 minutes. They reload when you click them.",
  "permissions": ["tabs", "alarms", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "sleep-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Sleep the current tab instantly (opens New Tab and sleeps this one)"
    }
  }
}
